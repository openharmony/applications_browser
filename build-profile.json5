      "srcPath": "./feature/tab"
    },
    {
      "name": "web",
      "srcPath": "./feature/web"
    },
    {
      "name": "bookmark",
      "srcPath": "./feature/bookmark"
    },
    {
      "name": "download",
      "srcPath": "./feature/download"
    },
    {
      "name": "settings",
      "srcPath": "./feature/settings"
    },
    {
      "name": "security",
      "srcPath": "./feature/security"
    },
    {
      "name": "entry",
      "srcPath": "./product/entry",
      "targets": [
