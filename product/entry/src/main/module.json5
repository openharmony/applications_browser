{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "MainAbility",
    "deviceTypes": [
      "default"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.WRITE_IMAGEVIDEO",
        "reason": "$string:permission_write_image_reason",
        "usedScene": {
          "abilities": [
            "MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:permission_write_download_reason",
        "usedScene": {
          "abilities": [
            "MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:permission_location_reason",
        "usedScene": {
          "abilities": [
            "MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:permission_location_reason",
        "usedScene": {
          "abilities": [
            "MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:permission_camera_reason",
        "usedScene": {
          "abilities": [
            "MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:permission_microphone_reason",
        "usedScene": {
          "abilities": [
            "MainAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "querySchemes": [
      "weixin",
      "wxopensdk",
      "qqopenapi",
      "sms",
      "https",
      "http"
    ],
    "dependencies": [
      {
        "bundleName": "com.ohos.scanservice",
        "moduleName": "scanservice",
        "versionCode": 30001271
      }
    ],
    "abilities": [
      {
        "name": "MainAbility",
        "srcEntry": "./ets/MainAbility/MainAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindow": "$profile:start_window",
        "startWindowIcon": "$media:app_start_splash_icon",
        "startWindowBackground": "$color:start_window_background",
        "orientation": "auto_rotation",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "https"
              },
              {
                "scheme": "http"
              }
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "text/html",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/xhtml+xml",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/pdf",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "text/plain",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "text/markdown",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/json",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "text/xml",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/xml",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "text/csv",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "linkFeature": "FileOpen"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/MainAbility/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}